{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "teammateMode": "in-process",
  "statusLine": {
    "type": "command",
    "command": "\"${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe\" -m rasdrive.agentops.cli statusline"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "\"${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe\" -m rasdrive.agentops.cli hook session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "\"${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe\" -m rasdrive.agentops.cli hook pre-tool-use"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 900,
            "command": "\"${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe\" -m rasdrive.agentops.cli hook task-completed"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git worktree list *)"
    ],
    "deny": [
      "Read(**/_restricted/**)",
      "Edit(**/_restricted/**)",
      "Write(**/_restricted/**)",
      "Bash(git push *)",
      "Bash(netsh *)",
      "Bash(reg add *)",
      "Bash(reg delete *)",
      "Edit(//C:/Programs/**)",
      "Write(//C:/Programs/**)",
      "Edit(//C:/Windows/**)",
      "Write(//C:/Windows/**)"
    ]
  }
}